+++ b/src/modules/MouseWithoutBorders/App/Core/EdgeStats.cs
@@ -0,0 +1,103 @@
+// Copyright (c) Microsoft Corporation
+// The Microsoft Corporation licenses this file to you under the MIT license.
+// See the LICENSE file in the project root for more information.
+
+using System;
+using System.IO;
+using System.IO.MemoryMappedFiles;
+
+// <summary>
+//     Shares edge-switch measurements with the settings window (MwbSettings.exe) through shared memory, so it can show
+//     what MWB actually measured for a drag into the edge versus a push from the border. The window can also turn on a
+//     test mode, where edge hits are measured but never switch; it has to keep a heartbeat going for that to stay on.
+//     Layout (int32): 0 sequence, 4 last kind, 8 test-mode heartbeat (Environment.TickCount, 0 = off),
+//     then per kind (1 = drag into the edge, 2 = push from the border) at 16 + (kind - 1) * 16:
+//     peak speed of the latest attempt, speed needed, 1 if the peak would switch, Environment.TickCount of the last hit.
+// </summary>
+namespace MouseWithoutBorders.Core;
+
+internal static class EdgeStats
+{
+    internal const int Drag = 1;
+    internal const int Push = 2;
+
+    private const string MapName = "Local\\MwbEdgeStats";
+    private const int Size = 64;
+
+    // A new attempt starts after this long without a hit of the same kind.
+    private const int AttemptGapMs = 400;
+    private const int HeartbeatTimeoutMs = 1500;
+
+    private static readonly int[] Peak = new int[3];
+    private static readonly int[] LastHit = new int[3];
+
+    private static MemoryMappedFile map;
+    private static MemoryMappedViewAccessor view;
+    private static bool unavailable;
+    private static int sequence;
+
+    internal static bool TestMode
+    {
+        get
+        {
+            var v = View();
+
+            if (v == null)
+            {
+                return false;
+            }
+
+            int beat = v.ReadInt32(8);
+            return beat != 0 && unchecked(Environment.TickCount - beat) is >= 0 and < HeartbeatTimeoutMs;
+        }
+    }
+
+    internal static void Publish(int kind, double speed, int needed)
+    {
+        var v = View();
+
+        if (v == null)
+        {
+            return;
+        }
+
+        int now = Environment.TickCount;
+
+        if (unchecked(now - LastHit[kind]) > AttemptGapMs)
+        {
+            Peak[kind] = 0;
+        }
+
+        Peak[kind] = Math.Max(Peak[kind], (int)Math.Min(int.MaxValue, Math.Max(0, speed)));
+        LastHit[kind] = now;
+
+        int offset = 16 + ((kind - 1) * 16);
+        v.Write(offset, Peak[kind]);
+        v.Write(offset + 4, needed);
+        v.Write(offset + 8, Peak[kind] >= needed ? 1 : 0);
+        v.Write(offset + 12, now);
+        v.Write(4, kind);
+        v.Write(0, ++sequence);
+    }
+
+    private static MemoryMappedViewAccessor View()
+    {
+        if (view != null || unavailable)
+        {
+            return view;
+        }
+
+        try
+        {
+            map = MemoryMappedFile.CreateOrOpen(MapName, Size);
+            view = map.CreateViewAccessor(0, Size);
+        }
+        catch (Exception e) when (e is IOException || e is UnauthorizedAccessException)
+        {
+            Logger.Log(e);
+            unavailable = true;
+        }
+
+        return view;
+    }
+}
