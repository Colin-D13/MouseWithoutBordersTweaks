+// See the LICENSE file in the project root for more information.
+
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using System.Threading;
+
+// <summary>
+//     Integer settings for the local MWB tweaks, read from %LOCALAPPDATA%\mwb8k\settings.ini (Key=Value, # comments).
+//     The file is checked for changes at most once a second, so edits apply without restarting.
+// </summary>
+namespace MouseWithoutBorders.Core;
+
+internal static class Tweaks
+{
+    // %LOCALAPPDATA%\mwb8k\settings.ini, found through the known folder, the environment, or next to the PowerToys folder.
+    private static readonly string[] Candidates = BuildCandidates();
+
+    private static Dictionary<string, int> values = new(StringComparer.OrdinalIgnoreCase);
+    private static DateTime loadedWriteTime = DateTime.MinValue;
+    private static long nextCheckTicks;
+    private static string lastStatus;
+
+    internal static int Get(string key, int defaultValue)
+    {
+        Refresh();
+        return values.TryGetValue(key, out int value) ? value : defaultValue;
+    }
+
+    private static void Refresh()
+    {
+        long now = Stopwatch.GetTimestamp();
+
+        if (now < Volatile.Read(ref nextCheckTicks))
+        {
+            return;
+        }
+
+        Volatile.Write(ref nextCheckTicks, now + Stopwatch.Frequency);
+
+        try
+        {
+            string filePath = Array.Find(Candidates, File.Exists);
+            DateTime writeTime = filePath != null ? File.GetLastWriteTimeUtc(filePath) : DateTime.MinValue;
+
+            if (filePath == null)
+            {
+                LogStatus("settings file not found, using defaults. Looked in: " + string.Join(" | ", Candidates));
+            }
+
+            if (writeTime == loadedWriteTime)
+            {
+                return;
+            }
+
+            var parsed = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
+
+            if (filePath != null)
+            {
+                foreach (string raw in File.ReadAllLines(filePath))
+                {
+                    string line = raw.Trim();
+                    int eq = line.IndexOf('=');
+
+                    if (line.StartsWith('#') || eq <= 0)
+                    {
+                        continue;
+                    }
+
+                    if (int.TryParse(line[(eq + 1)..].Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int value))
+                    {
+                        parsed[line[..eq].Trim()] = value;
+                    }
+                }
+            }
+
+            values = parsed;
+            loadedWriteTime = writeTime;
+            LogStatus($"{filePath}: {string.Join(", ", parsed.Select(kv => kv.Key + "=" + kv.Value))}");
+        }
+        catch (Exception e)
+        {
+            // The settings window may be saving the file right now; try again on the next check.
+            LogStatus("couldn't read settings: " + e.GetType().Name + ": " + e.Message);
+        }
+    }
+
+    private static void LogStatus(string status)
+    {
+        if (status != lastStatus)
+        {
+            lastStatus = status;
+            Logger.Log($"{nameof(Tweaks)}: {status}");
+        }
+    }
+
+    private static string[] BuildCandidates()
+    {
+        var paths = new List<string>();
+
+        // The tools live in %LOCALAPPDATA%\Programs\mwb8k (older setups: %LOCALAPPDATA%\mwb8k).
+        void Add(string localAppData)
+        {
+            if (!string.IsNullOrEmpty(localAppData))
+            {
+                foreach (string path in new[] { Path.Combine(localAppData, "Programs", "mwb8k", "settings.ini"), Path.Combine(localAppData, "mwb8k", "settings.ini") })
+                {
+                    if (!paths.Contains(path, StringComparer.OrdinalIgnoreCase))
+                    {
+                        paths.Add(path);
+                    }
+                }
+            }
+        }
+
+        Add(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData));
+        Add(Environment.GetEnvironmentVariable("LOCALAPPDATA"));
+
+        // PowerToys is installed per user in %LOCALAPPDATA%\PowerToys.
+        string assemblyDir = Path.GetDirectoryName(typeof(Tweaks).Assembly.Location);
+        Add(string.IsNullOrEmpty(assemblyDir) ? null : Path.GetDirectoryName(assemblyDir));
+        return paths.ToArray();
+    }
+}
