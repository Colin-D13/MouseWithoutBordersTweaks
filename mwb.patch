new file mode 100644
index 0000000..5e3b7eb
--- /dev/null
+++ b/src/modules/MouseWithoutBorders/App/Core/EdgePush.cs
@@ -0,0 +1,310 @@
+// Copyright (c) Microsoft Corporation
+// The Microsoft Corporation licenses this file to you under the MIT license.
+// See the LICENSE file in the project root for more information.
+
+using System;
+using System.Diagnostics;
+using System.Text;
+
+// <summary>
+//     Edge resistance for Easy Mouse: the cursor only switches machines when it's moved into a screen edge hard enough.
+//     Settings (%LOCALAPPDATA%\mwb8k\settings.ini, speeds in pixels per second):
+//       EdgeFlickSpeed:  dragging into the edge, measured from the cursor on arrival and from raw input
+//                        while the push carries on without a pause (0 = switch on touch).
+//       EdgePushSpeed:   pushing after the cursor has rested on the border (raw input, see RawPush).
+//       EdgePushRestMs:  how long the cursor has to rest on the border, without pushing, before EdgePushSpeed applies.
+// </summary>
+namespace MouseWithoutBorders.Core;
+
+internal enum EdgeDirection
+{
+    Left,
+    Right,
+    Up,
+    Down,
+}
+
+internal static class EdgePush
+{
+    private const int DefaultFlickSpeed = 2500;
+    private const int DefaultPushSpeed = 1200;
+    private const int DefaultRestMs = 100;
+    private const int Capacity = 4096;
+
+    // Movement toward the edge below this still counts as resting on the border.
+    private const double RestSpeed = 100;
+
+    // Speeds are measured over the last 20 ms.
+    private static readonly long WindowTicks = Stopwatch.Frequency / 50;
+
+    private static readonly object SyncLock = new();
+    private static readonly long[] Ticks = new long[Capacity];
+    private static readonly int[] Xs = new int[Capacity];
+    private static readonly int[] Ys = new int[Capacity];
+
+    private static int head;
+    private static int count;
+
+    // The edge being watched, and since when the cursor has been on it without leaving (0 = not on it).
+    private static bool tracking;
+    private static EdgeDirection trackEdge;
+    private static int trackAt;
+    private static long borderSince;
+
+    // Latched once the cursor has rested on the watched edge, until it moves off it.
+    private static bool resting;
+
+    private static long lastLogTicks;
+
+    internal static void Record(int x, int y)
+    {
+        lock (SyncLock)
+        {
+            long now = Stopwatch.GetTimestamp();
+            Ticks[head] = now;
+            Xs[head] = x;
+            Ys[head] = y;
+            head = (head + 1) % Capacity;
+
+            if (count < Capacity)
+            {
+                count++;
+            }
+
+            if (tracking)
+            {
+                if (!OnBorder(trackEdge, trackAt, x, y))
+                {
+                    borderSince = 0;
+                    resting = false;
+                }
+                else if (borderSince == 0)
+                {
+                    borderSince = now;
+                }
+            }
+        }
+    }
+
+    // Positions before a machine switch are in a different coordinate space.
+    internal static void Reset()
+    {
+        lock (SyncLock)
+        {
+            count = 0;
+            tracking = false;
+            borderSince = 0;
+            resting = false;
+        }
+    }
+
+    internal static bool TryGetLatest(out int x, out int y)
+    {
+        lock (SyncLock)
+        {
+            int last = (head - 1 + Capacity) % Capacity;
+            x = Xs[last];
+            y = Ys[last];
+            return count > 0;
+        }
+    }
+
+    // edgeAt: the cursor is on the edge at x/y < edgeAt (Left/Up) or >= edgeAt (Right/Down).
+    internal static bool IsFastEnough(EdgeDirection edge, int edgeAt)
+    {
+        int flickSpeed = Tweaks.Get("EdgeFlickSpeed", DefaultFlickSpeed);
+
+        if (flickSpeed <= 0)
+        {
+            EdgeStats.Publish(EdgeStats.Drag, 0, 0);
+            return !EdgeStats.TestMode;
+        }
+
+        int pushSpeed = Math.Max(1, Tweaks.Get("EdgePushSpeed", DefaultPushSpeed));
+        long restTicks = Math.Max(0, Tweaks.Get("EdgePushRestMs", DefaultRestMs)) * Stopwatch.Frequency / 1000;
+
+        RawPush.Arm();
+
+        // A drag is the cursor arriving fast, or the raw push carrying on without a pause; once the cursor
+        // has rested on the border, the push is read from raw input (the cursor is stopped there).
+        double cursorSpeed = CursorSpeedToward(edge);
+        double rawSpeed = RawPush.SpeedToward(edge, WindowTicks);
+        bool fromBorder = cursorSpeed < flickSpeed && IsResting(edge, edgeAt, restTicks);
+        double speed = fromBorder ? rawSpeed : Math.Max(cursorSpeed, rawSpeed);
+        int needed = fromBorder ? pushSpeed : flickSpeed;
+
+        EdgeStats.Publish(fromBorder ? EdgeStats.Push : EdgeStats.Drag, speed, needed);
+
+        if (speed < needed)
+        {
+            return false;
+        }
+
+        LogDecision(edge, edgeAt, fromBorder, cursorSpeed, rawSpeed, needed, restTicks);
+
+        if (EdgeStats.TestMode)
+        {
+            // No switch happens in test mode, so start over as if it had: the cursor has to rest on the border again.
+            lock (SyncLock)
+            {
+                resting = false;
+                borderSince = borderSince == 0 ? 0 : Stopwatch.GetTimestamp();
+            }
+
+            return false;
+        }
+
+        return true;
+    }
+
+    // Hook positions can land past the edge while the cursor is pushed against it, so "on the border" is a range.
+    private static bool OnBorder(EdgeDirection edge, int edgeAt, int x, int y) => edge switch
+    {
+        EdgeDirection.Left => x < edgeAt,
+        EdgeDirection.Right => x >= edgeAt,
+        EdgeDirection.Up => y < edgeAt,
+        _ => y >= edgeAt,
+    };
+
+    // Cursor speed toward the edge over the 20 ms before the latest position, in pixels per second.
+    private static double CursorSpeedToward(EdgeDirection edge)
+    {
+        lock (SyncLock)
+        {
+            if (count < 2)
+            {
+                return 0;
+            }
+
+            int last = (head - 1 + Capacity) % Capacity;
+            int start = last;
+
+            // The newest sample at least a window older than the latest one, or the oldest we have.
+            for (int i = 1; i < count; i++)
+            {
+                start = (last - i + Capacity) % Capacity;
+
+                if (Ticks[last] - Ticks[start] >= WindowTicks)
+                {
+                    break;
+                }
+            }
+
+            long elapsed = Ticks[last] - Ticks[start];
+
+            // Too little history (e.g. right after a switch) to tell a flick from noise.
+            if (elapsed < WindowTicks / 2)
+            {
+                return 0;
+            }
+
+            int dx = Xs[last] - Xs[start];
+            int dy = Ys[last] - Ys[start];
+            int toward = edge switch
+            {
+                EdgeDirection.Left => -dx,
+                EdgeDirection.Right => dx,
+                EdgeDirection.Up => -dy,
+                _ => dy,
+            };
+
+            return toward * (double)Stopwatch.Frequency / elapsed;
+        }
+    }
+
+    // On the border: the cursor sat on this edge for restTicks before the current push window without being pushed
+    // into it. A drag that carries on into the edge never gets there, so it keeps needing EdgeFlickSpeed.
+    private static bool IsResting(EdgeDirection edge, int edgeAt, long restTicks)
+    {
+        lock (SyncLock)
+        {
+            if (count == 0)
+            {
+                return false;
+            }
+
+            Track(edge, edgeAt);
+
+            if (resting)
+            {
+                return true;
+            }
+
+            if (borderSince == 0 || borderSince > Stopwatch.GetTimestamp() - WindowTicks - restTicks)
+            {
+                return false;
+            }
+        }
+
+        if (!RawPush.WasStill(edge, WindowTicks, restTicks, RestSpeed))
+        {
+            return false;
+        }
+
+        lock (SyncLock)
+        {
+            resting = tracking && trackEdge == edge && trackAt == edgeAt && borderSince != 0;
+            return resting;
+        }
+    }
+
+    // Start watching an edge: find since when the cursor has been on it from the recent positions,
+    // after that Record keeps it up to date.
+    private static void Track(EdgeDirection edge, int edgeAt)
+    {
+        if (tracking && trackEdge == edge && trackAt == edgeAt)
+        {
+            return;
+        }
+
+        tracking = true;
+        trackEdge = edge;
+        trackAt = edgeAt;
+        resting = false;
+        borderSince = 0;
+
+        int last = (head - 1 + Capacity) % Capacity;
+
+        for (int i = 0; i < count; i++)
+        {
+            int idx = (last - i + Capacity) % Capacity;
+
+            if (!OnBorder(edge, edgeAt, Xs[idx], Ys[idx]))
+            {
+                break;
+            }
+
+            borderSince = Ticks[idx];
+        }
+    }
+
+    // Why a hit passed, for tuning: how long the cursor had been on the border and the recent positions.
+    private static void LogDecision(EdgeDirection edge, int edgeAt, bool fromBorder, double cursorSpeed, double rawSpeed, int needed, long restTicks)
+    {
+        long now = Stopwatch.GetTimestamp();
+
+        if (now - lastLogTicks < Stopwatch.Frequency / 3)
+        {
+            return;
+        }
+
+        lastLogTicks = now;
+        var recent = new StringBuilder();
+        double borderMs;
+
+        lock (SyncLock)
+        {
+            bool tracked = tracking && trackEdge == edge && trackAt == edgeAt;
+            borderMs = !tracked || borderSince == 0 ? 0 : (now - borderSince) * 1000.0 / Stopwatch.Frequency;
+            int last = (head - 1 + Capacity) % Capacity;
+
+            for (int i = 0; i < Math.Min(count, 6); i++)
+            {
+                int idx = (last - i + Capacity) % Capacity;
+                recent.Append($"{Xs[idx]},{Ys[idx]}@{(now - Ticks[idx]) * 1000.0 / Stopwatch.Frequency:F1} ");
+            }
+        }
+
+        Logger.Log($"EdgePush {edge} edgeAt={edgeAt}: {(fromBorder ? "PUSH" : "DRAG")} passes (needed {needed}) cursor={cursorSpeed:F0} raw={rawSpeed:F0} latched={resting} onBorderFor={borderMs:F0}ms restMs={restTicks * 1000 / Stopwatch.Frequency} {RawPush.Describe(edge, WindowTicks, restTicks)} recent(x,y@ms ago): {recent}");
+    }
+}
diff --git a/src/modules/MouseWithoutBorders/App/Core/EdgeStats.cs b/src/modules/MouseWithoutBorders/App/Core/EdgeStats.cs
