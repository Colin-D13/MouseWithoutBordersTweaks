diff --git a/src/modules/MouseWithoutBorders/App/Core/MouseMoveCoalescer.cs b/src/modules/MouseWithoutBorders/App/Core/MouseMoveCoalescer.cs
new file mode 100644
index 0000000..bb52cdb
--- /dev/null
+++ b/src/modules/MouseWithoutBorders/App/Core/MouseMoveCoalescer.cs
@@ -0,0 +1,204 @@
+// Copyright (c) Microsoft Corporation
+// The Microsoft Corporation licenses this file to you under the MIT license.
+// See the LICENSE file in the project root for more information.
+
+using System;
+using System.Diagnostics;
+using System.Runtime.InteropServices;
+using System.Threading;
+
+using MouseWithoutBorders.Class;
+
+// <summary>
+//     Caps the rate of mouse-move packages sent to the remote machine.
+//     High polling rate mice (4-8 kHz) otherwise produce one encrypted TCP package and one
+//     remote SendInput per report, which the remote machine can't keep up with, so moves
+//     queue up and the remote cursor lags by up to seconds.
+//     Absolute moves are coalesced to the latest position, relative moves are summed.
+//     Non-move events flush any pending move first so ordering is preserved.
+//     The rate is MaxMouseMoveHz in %LOCALAPPDATA%\mwb8k\settings.ini (default 500, 0 = disabled).
+// </summary>
+namespace MouseWithoutBorders.Core;
+
+internal static class MouseMoveCoalescer
+{
+    private const int DefaultMaxHz = 500;
+    private const uint CREATE_WAITABLE_TIMER_HIGH_RESOLUTION = 0x00000002;
+    private const uint TIMER_ALL_ACCESS = 0x1F0003;
+    private const uint INFINITE = 0xFFFFFFFF;
+
+    private static readonly object SendLock = new();
+    private static readonly DATA PendingMove = new();
+    private static readonly AutoResetEvent FlushSignal = new(false);
+
+    private static bool pendingValid;
+    private static bool pendingRelative;
+    private static long lastMoveSendTicks;
+    private static System.Threading.Thread flushThread;
+
+    internal static void Send(DATA package)
+    {
+        lock (SendLock)
+        {
+            if (MinIntervalTicks <= 0 || package.Md.dwFlags != WM.WM_MOUSEMOVE)
+            {
+                FlushLocked();
+                Common.SkSend(package, null, false);
+                return;
+            }
+
+            bool relative = IsRelative(package.Md);
+
+            if (pendingValid && (PendingMove.Des != package.Des || pendingRelative != relative))
+            {
+                FlushLocked();
+            }
+
+            if (pendingValid && relative)
+            {
+                PendingMove.Md.X = Encode(Decode(PendingMove.Md.X) + Decode(package.Md.X));
+                PendingMove.Md.Y = Encode(Decode(PendingMove.Md.Y) + Decode(package.Md.Y));
+            }
+            else
+            {
+                PendingMove.Des = package.Des;
+                PendingMove.Type = package.Type;
+                PendingMove.Md = package.Md;
+            }
+
+            pendingValid = true;
+            pendingRelative = relative;
+
+            if (Stopwatch.GetTimestamp() - lastMoveSendTicks >= MinIntervalTicks)
+            {
+                FlushLocked();
+            }
+            else
+            {
+                EnsureFlushThread();
+                _ = FlushSignal.Set();
+            }
+        }
+    }
+
+    // Sends the pending move now, e.g. before switching to another machine.
+    internal static void Flush()
+    {
+        lock (SendLock)
+        {
+            FlushLocked();
+        }
+    }
+
+    private static void FlushLocked()
+    {
+        if (!pendingValid)
+        {
+            return;
+        }
+
+        pendingValid = false;
+
+        // Drop moves meant for a machine we have already switched away from.
+        if (PendingMove.Des == MachineStuff.desMachineID)
+        {
+            Common.SkSend(PendingMove, null, false);
+            lastMoveSendTicks = Stopwatch.GetTimestamp();
+        }
+    }
+
+    private static void EnsureFlushThread()
+    {
+        if (flushThread != null)
+        {
+            return;
+        }
+
+        flushThread = new System.Threading.Thread(FlushLoop)
+        {
+            IsBackground = true,
+            Name = "MouseMoveCoalescer",
+            Priority = ThreadPriority.AboveNormal,
+        };
+        Thread.UpdateThreads(flushThread);
+        flushThread.Start();
+    }
+
+    private static void FlushLoop()
+    {
+        IntPtr timer = CreateWaitableTimerExW(IntPtr.Zero, null, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+
+        while (true)
+        {
+            try
+            {
+                _ = FlushSignal.WaitOne();
+
+                long waitTicks;
+                lock (SendLock)
+                {
+                    if (!pendingValid)
+                    {
+                        continue;
+                    }
+
+                    waitTicks = lastMoveSendTicks + MinIntervalTicks - Stopwatch.GetTimestamp();
+                }
+
+                if (waitTicks > 0)
+                {
+                    SleepPrecise(timer, waitTicks);
+                }
+
+                Flush();
+            }
+            catch (Exception e)
+            {
+                Logger.Log(e);
+            }
+        }
+    }
+
+    private static void SleepPrecise(IntPtr timer, long stopwatchTicks)
+    {
+        // Relative due time in 100ns units is negative.
+        long dueTime = -Math.Max(1, stopwatchTicks * 10_000_000 / Stopwatch.Frequency);
+
+        if (timer != IntPtr.Zero && SetWaitableTimer(timer, ref dueTime, 0, IntPtr.Zero, IntPtr.Zero, false))
+        {
+            _ = WaitForSingleObject(timer, INFINITE);
+        }
+        else
+        {
+            Thread.Sleep(1);
+        }
+    }
+
+    private static bool IsRelative(MOUSEDATA md)
+    {
+        return Math.Abs(md.X) >= Event.MOVE_MOUSE_RELATIVE && Math.Abs(md.Y) >= Event.MOVE_MOUSE_RELATIVE;
+    }
+
+    private static int Decode(int v) => v < 0 ? v + Event.MOVE_MOUSE_RELATIVE : v - Event.MOVE_MOUSE_RELATIVE;
+
+    private static int Encode(int v) => v < 0 ? v - Event.MOVE_MOUSE_RELATIVE : v + Event.MOVE_MOUSE_RELATIVE;
+
+    private static long MinIntervalTicks
+    {
+        get
+        {
+            int hz = Tweaks.Get("MaxMouseMoveHz", DefaultMaxHz);
+            return hz <= 0 ? 0 : Stopwatch.Frequency / hz;
+        }
+    }
+
+    [DllImport("kernel32.dll", SetLastError = true, CharSet = CharSet.Unicode)]
+    private static extern IntPtr CreateWaitableTimerExW(IntPtr lpTimerAttributes, string lpTimerName, uint dwFlags, uint dwDesiredAccess);
+
+    [DllImport("kernel32.dll", SetLastError = true)]
+    [return: MarshalAs(UnmanagedType.Bool)]
+    private static extern bool SetWaitableTimer(IntPtr hTimer, ref long pDueTime, int lPeriod, IntPtr pfnCompletionRoutine, IntPtr lpArgToCompletionRoutine, [MarshalAs(UnmanagedType.Bool)] bool fResume);
+
+    [DllImport("kernel32.dll", SetLastError = true)]
+    private static extern uint WaitForSingleObject(IntPtr hHandle, uint dwMilliseconds);
+}
diff --git a/src/modules/MouseWithoutBorders/App/Core/RawPush.cs b/src/modules/MouseWithoutBorders/App/Core/RawPush.cs
new file mode 100644
index 0000000..ebf53c1
--- /dev/null
+++ b/src/modules/MouseWithoutBorders/App/Core/RawPush.cs
@@ -0,0 +1,340 @@
+// Copyright (c) Microsoft Corporation
+// The Microsoft Corporation licenses this file to you under the MIT license.
+// See the LICENSE file in the project root for more information.
+
+using System;
+using System.Diagnostics;
+using System.Runtime.InteropServices;
+using System.Threading;
+using System.Windows.Forms;
+
+using MouseWithoutBorders.Class;
+
+// <summary>
+//     Measures how hard the physical mouse is pushed while the cursor rests against a screen edge.
+//     The cursor position stops changing there, so this reads raw mouse input instead. Raw input is
+//     only registered while the cursor touches an edge (Arm) and is dropped a second after it moves away.
+// </summary>
+namespace MouseWithoutBorders.Core;
+
+internal static class RawPush
+{
+    private const int WM_INPUT = 0x00FF;
+    private const int WM_APP_REGISTER = 0x8001;
+    private const uint RIDEV_REMOVE = 0x00000001;
+    private const uint RIDEV_INPUTSINK = 0x00000100;
+    private const uint RID_INPUT = 0x10000003;
+    private const uint RIM_TYPEMOUSE = 0;
+    private const ushort MOUSE_MOVE_ABSOLUTE = 0x0001;
+    private const uint SPI_GETMOUSESPEED = 0x0070;
+    // Enough for a couple of seconds of 8 kHz input, so long rest times are still covered.
+    private const int Capacity = 32768;
+
+    // Windows pointer speed setting (1-20) to pixels per mouse count, without Enhance Pointer Precision.
+    private static readonly double[] PointerSpeedScale = { 0, 1 / 32.0, 1 / 16.0, 1 / 8.0, 2 / 8.0, 3 / 8.0, 4 / 8.0, 5 / 8.0, 6 / 8.0, 7 / 8.0, 1, 1.25, 1.5, 1.75, 2, 2.25, 2.5, 2.75, 3, 3.25, 3.5 };
+
+    private static readonly long IdleTicks = Stopwatch.Frequency; // unregister 1 s after the cursor left the edge
+
+    private static readonly object SyncLock = new();
+    private static readonly long[] Ticks = new long[Capacity];
+
+    // Running totals of the movement up to and including each sample, so any time range is two lookups.
+    private static readonly long[] SumX = new long[Capacity];
+    private static readonly long[] SumY = new long[Capacity];
+    private static long totalX;
+    private static long totalY;
+
+    // Totals before the oldest sample still kept.
+    private static long baseX;
+    private static long baseY;
+    private static int head;
+    private static int count;
+
+    private static int started;
+    private static long lastArmTicks;
+    private static long registeredSinceTicks;
+    private static int armX;
+    private static int armY;
+    private static volatile bool registered;
+    private static volatile IntPtr windowHandle;
+    private static double pixelsPerCount = 1;
+
+    // Last raw move seen by the window, before filtering; for diagnostics.
+    internal static int LastSeenDx { get; private set; }
+
+    internal static void Arm()
+    {
+        if (EdgePush.TryGetLatest(out int x, out int y))
+        {
+            armX = x;
+            armY = y;
+        }
+
+        Volatile.Write(ref lastArmTicks, Stopwatch.GetTimestamp());
+
+        if (Interlocked.Exchange(ref started, 1) == 0)
+        {
+            var thread = new System.Threading.Thread(Run) { IsBackground = true, Name = nameof(RawPush) };
+            thread.SetApartmentState(ApartmentState.STA);
+            Thread.UpdateThreads(thread);
+            thread.Start();
+        }
+        else if (!registered && windowHandle != IntPtr.Zero)
+        {
+            _ = NativeMethods.PostMessage(windowHandle, WM_APP_REGISTER, IntPtr.Zero, IntPtr.Zero);
+        }
+    }
+
+    // Physical mouse speed toward the edge over the last window, in (approximate) pixels per second.
+    internal static double SpeedToward(EdgeDirection edge, long windowTicks)
+    {
+        long now = Stopwatch.GetTimestamp();
+        return PixelsToward(edge, now - windowTicks, now) * Stopwatch.Frequency / windowTicks;
+    }
+
+    // Whether the mouse was (nearly) still toward the edge for restTicks before the last window,
+    // with raw input recorded for that whole time.
+    internal static bool WasStill(EdgeDirection edge, long windowTicks, long restTicks, double maxSpeed)
+    {
+        long end = Stopwatch.GetTimestamp() - windowTicks;
+        long start = end - restTicks;
+        long since = Volatile.Read(ref registeredSinceTicks);
+
+        if (!registered || since == 0 || since > start)
+        {
+            return false;
+        }
+
+        return PixelsToward(edge, start, end) <= maxSpeed * restTicks / Stopwatch.Frequency;
+    }
+
+    internal static string Describe(EdgeDirection edge, long windowTicks, long restTicks)
+    {
+        long now = Stopwatch.GetTimestamp();
+        long since = Volatile.Read(ref registeredSinceTicks);
+        double registeredMs = since == 0 ? -1 : (now - since) * 1000.0 / Stopwatch.Frequency;
+        double restPixels = PixelsToward(edge, now - windowTicks - restTicks, now - windowTicks);
+        return $"rawRegistered={registered} for {registeredMs:F0}ms rawSamples={count} restWindowPx={restPixels:F1}";
+    }
+
+    // Movement toward the edge between from (exclusive) and to (inclusive), in pixels.
+    private static double PixelsToward(EdgeDirection edge, long from, long to)
+    {
+        long sumX;
+        long sumY;
+
+        lock (SyncLock)
+        {
+            if (count == 0)
+            {
+                return 0;
+            }
+
+            int a = LastAtOrBefore(from);
+            int b = LastAtOrBefore(to);
+            sumX = TotalAt(SumX, baseX, b) - TotalAt(SumX, baseX, a);
+            sumY = TotalAt(SumY, baseY, b) - TotalAt(SumY, baseY, a);
+        }
+
+        long toward = edge switch
+        {
+            EdgeDirection.Left => -sumX,
+            EdgeDirection.Right => sumX,
+            EdgeDirection.Up => -sumY,
+            _ => sumY,
+        };
+
+        return toward * pixelsPerCount;
+    }
+
+    // Samples are in time order from the oldest (0) to the newest (count - 1).
+    private static int Physical(int logical) => (head - count + logical + Capacity) % Capacity;
+
+    // The newest sample at or before t, or -1 if every sample is later.
+    private static int LastAtOrBefore(long t)
+    {
+        int lo = 0;
+        int hi = count - 1;
+        int found = -1;
+
+        while (lo <= hi)
+        {
+            int mid = (lo + hi) / 2;
+
+            if (Ticks[Physical(mid)] <= t)
+            {
+                found = mid;
+                lo = mid + 1;
+            }
+            else
+            {
+                hi = mid - 1;
+            }
+        }
+
+        return found;
+    }
+
+    // Running total up to a sample; -1 means before the oldest sample still kept.
+    private static long TotalAt(long[] sums, long baseline, int logical) => logical >= 0 ? sums[Physical(logical)] : baseline;
+
+    internal static void Add(int dx, int dy)
+    {
+        lock (SyncLock)
+        {
+            // The oldest sample is about to be overwritten: the totals before the next oldest are its totals.
+            if (count == Capacity)
+            {
+                baseX = SumX[head];
+                baseY = SumY[head];
+            }
+
+            totalX += dx;
+            totalY += dy;
+            Ticks[head] = Stopwatch.GetTimestamp();
+            SumX[head] = totalX;
+            SumY[head] = totalY;
+            head = (head + 1) % Capacity;
+
+            if (count < Capacity)
+            {
+                count++;
+            }
+        }
+    }
+
+    private static void Run()
+    {
+        try
+        {
+            var window = new SinkWindow();
+            windowHandle = window.Handle;
+            Register(true);
+
+            using var timer = new System.Windows.Forms.Timer { Interval = 250 };
+            timer.Tick += (s, e) =>
+            {
+                // Stay registered while the cursor still sits where it last touched an edge, so a push after a long rest counts.
+                bool stillAtEdge = EdgePush.TryGetLatest(out int x, out int y) && x == armX && y == armY;
+
+                if (registered && !stillAtEdge && Stopwatch.GetTimestamp() - Volatile.Read(ref lastArmTicks) > IdleTicks)
+                {
+                    Register(false);
+                }
+            };
+            timer.Start();
+            Application.Run();
+        }
+        catch (Exception e)
+        {
+            Logger.Log(e);
+        }
+    }
+
+    private static void Register(bool enable)
+    {
+        if (enable)
+        {
+            int speed = 10;
+            _ = SystemParametersInfo(SPI_GETMOUSESPEED, 0, ref speed, 0);
+            pixelsPerCount = PointerSpeedScale[Math.Clamp(speed, 1, 20)];
+
+            lock (SyncLock)
+            {
+                count = 0;
+                baseX = totalX;
+                baseY = totalY;
+            }
+        }
+
+        var device = new RAWINPUTDEVICE
+        {
+            UsagePage = 0x01,
+            Usage = 0x02,
+            Flags = enable ? RIDEV_INPUTSINK : RIDEV_REMOVE,
+            Target = enable ? windowHandle : IntPtr.Zero,
+        };
+
+        if (RegisterRawInputDevices(new[] { device }, 1, (uint)Marshal.SizeOf<RAWINPUTDEVICE>()))
+        {
+            registered = enable;
+            Volatile.Write(ref registeredSinceTicks, enable ? Stopwatch.GetTimestamp() : 0);
+        }
+        else
+        {
+            Logger.Log($"{nameof(RawPush)}: RegisterRawInputDevices({enable}) failed: {Marshal.GetLastWin32Error()}");
+        }
+    }
+
+    private static unsafe void Read(IntPtr rawInput)
+    {
+        const int bufferSize = 64;
+        byte* buffer = stackalloc byte[bufferSize];
+        uint size = bufferSize;
+        uint headerSize = (uint)(8 + (2 * IntPtr.Size));
+
+        if (GetRawInputData(rawInput, RID_INPUT, (IntPtr)buffer, ref size, headerSize) == uint.MaxValue || *(uint*)buffer != RIM_TYPEMOUSE)
+        {
+            return;
+        }
+
+        // RAWINPUTHEADER { dwType, dwSize, hDevice, wParam }, then RAWMOUSE { usFlags, ulButtons, ulRawButtons, lLastX, lLastY, ... }.
+        IntPtr device = *(IntPtr*)(buffer + 8);
+        byte* mouse = buffer + headerSize;
+        int dx = *(int*)(mouse + 12);
+        int dy = *(int*)(mouse + 16);
+        LastSeenDx = dx;
+
+        // Skip injected input (no device, e.g. MWB's own SendInput) and absolute devices (tablets, remote desktop).
+        if (device == IntPtr.Zero || (*(ushort*)mouse & MOUSE_MOVE_ABSOLUTE) != 0 || (dx == 0 && dy == 0))
+        {
+            return;
+        }
+
+        Add(dx, dy);
+    }
+
+    private sealed class SinkWindow : NativeWindow
+    {
+        private static readonly IntPtr HWND_MESSAGE = new(-3);
+
+        internal SinkWindow()
+        {
+            CreateHandle(new CreateParams { Parent = HWND_MESSAGE });
+        }
+
+        protected override void WndProc(ref Message m)
+        {
+            if (m.Msg == WM_INPUT)
+            {
+                Read(m.LParam);
+            }
+            else if (m.Msg == WM_APP_REGISTER && !registered)
+            {
+                Register(true);
+            }
+
+            base.WndProc(ref m);
+        }
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    private struct RAWINPUTDEVICE
+    {
+        internal ushort UsagePage;
+        internal ushort Usage;
+        internal uint Flags;
+        internal IntPtr Target;
+    }
+
+    [DllImport("user32.dll", SetLastError = true)]
+    [return: MarshalAs(UnmanagedType.Bool)]
+    private static extern bool RegisterRawInputDevices(RAWINPUTDEVICE[] devices, uint numDevices, uint size);
+
+    [DllImport("user32.dll")]
+    private static extern uint GetRawInputData(IntPtr rawInput, uint command, IntPtr data, ref uint size, uint headerSize);
+
+    [DllImport("user32.dll", SetLastError = true)]
+    [return: MarshalAs(UnmanagedType.Bool)]
+    private static extern bool SystemParametersInfo(uint action, uint param, ref int value, uint winIni);
+}
